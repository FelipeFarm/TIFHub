// Local development config. Webflow Cloud provisions the real database and file
// storage on deploy (step 5); the binding names (DB, FILES) must stay the same.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ideafarm-hub",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // Not secret. MONDAY_API_TOKEN is a secret: .dev.vars locally, Webflow Cloud settings in production.
  "vars": { "MONDAY_BOARD_ID": "18440599608", "HUB_URL": "https://hub.theideafarm.com" },
  "assets": { "directory": ".open-next/assets", "binding": "ASSETS" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ideafarm-hub",
      "database_id": "local-dev",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "ideafarm-hub-files" }]
}
