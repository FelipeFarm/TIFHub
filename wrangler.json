{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ideafarm-hub",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "vars": {
    "MONDAY_BOARD_ID": "18440599608",
    "HUB_URL": "https://tifhub.webflow.io"
  },
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "ideafarm-hub",
      "database_id": "local-dev",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "ideafarm-hub-files"
    }
  ]
}
