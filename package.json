{
  "name": "ideafarm-hub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 4183",
    "build": "next build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:seed": "node scripts/seed.mjs && wrangler d1 execute DB --local --file=seed/seed.sql",
    "db:reset": "rm -rf .wrangler/state && npm run db:migrate && npm run db:seed",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "preview:worker": "wrangler dev --port 4184 --ip 127.0.0.1",
    "admin:invite": "node scripts/invite-admin.mjs"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "1.20.17",
    "drizzle-orm": "0.45.4",
    "next": "15.5.29",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.29",
    "@types/react": "^19.1.6",
    "@types/react-dom": "^19.1.5",
    "drizzle-kit": "0.31.11",
    "typescript": "^5.8.3",
    "wrangler": "4.164.0"
  },
  "allowScripts": {
    "esbuild@0.18.20": true,
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "workerd@1.20261117.1": true
  }
}
